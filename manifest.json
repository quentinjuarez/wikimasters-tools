{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "fr",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "src/logic.js",
        "src/store.js",
        "src/api.js",
        "src/prices.js",
        "src/registry.js",
        "src/collection.js",
        "src/ui.js",
        "src/prefs.js",
        "src/badges.js",
        "src/bar.js",
        "src/estimate.js",
        "src/sale.js",
        "src/bid.js",
        "src/priceview.js",
        "src/filters.js",
        "src/packs.js",
        "src/app.js"
      ],
      "css": [
        "src/style.css"
      ],
      "run_at": "document_start"
    }
  ]
}
